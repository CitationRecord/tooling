# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# CourtListener API token, used by resolve/.
# Get one at https://www.courtlistener.com/help/api/
COURTLISTENER_API_TOKEN=

# Base model credentials, used by runner/. One per system under test.
# A system with no credential is refused before anything is sent, never
# skipped quietly: a run missing a system is a run that measured less than
# it says it did.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# xAI. Grok is NOT in the published scope of Edition One; it is run
# exploratorily to find out whether it belongs there.
XAI_API_KEY=
